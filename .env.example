# Sports Betting Sniper settings. Copy to .env (never commit .env) or set these in the environment.
# Everything is optional: with nothing set the app runs on saved snapshots or hypothetical sample data.

# The Odds API v4 key. Only needed for live scans (`--source live`); those spend credits.
# On this PC the existing pipelines' saved ODDS_API_KEY is used when this is not set.
ODDS_API_KEY=

# Where the Sniper keeps its own tables. SQLite by default; PostgreSQL also works.
# SNIPER_DATABASE_URL=sqlite:///data/sniper/sniper.db
# SNIPER_DATABASE_URL=postgresql://user:password@localhost:5432/sniper

# The existing pipelines' Postgres, read-only, for snapshots already saved by the scheduled scanners.
# Leave unset to use that pipeline's own setting.
# SNIPER_SAVED_QUOTES_DSN=postgresql://user:password@localhost:5432/nba

# What a live scan asks for. Lists and maps are JSON. Each market costs one credit per game per scan.
# SNIPER_SPORTS=["nfl","nba"]
# SNIPER_BOOKMAKERS=["draftkings","fanduel","betmgm","espnbet","fanatics","pinnacle"]
# SNIPER_MARKETS={"nba":["player_points","player_rebounds","player_assists","player_threes"],"nfl":["player_anytime_td","player_pass_tds","player_rush_yds","player_reception_yds"]}
# SNIPER_LOOKAHEAD_HOURS=24

# Credit protection for live scans.
# SNIPER_CREDIT_FLOOR=2000
# SNIPER_MAX_CREDITS_PER_SCAN=60

# Pricing. Sharp books are references only; the uncertainty floor is in probability points (0.015 = 1.5).
# SNIPER_SHARP_BOOKS=["pinnacle"]
# SNIPER_BET_BOOKS=["fanduel","draftkings","espnbet"]
# SNIPER_REFERENCE_WEIGHTS={"pinnacle":3.0}
# SNIPER_DEVIG_METHOD=power
# SNIPER_UNCERTAINTY_FLOOR=0.015
# SNIPER_CONFIDENCE_Z=1.0
# SNIPER_MIN_REFERENCE_BOOKS=1
# SNIPER_MAX_PLAUSIBLE_EV=0.15

# What the dashboard shows by default.
# SNIPER_MIN_EV=0.04
# SNIPER_MIN_CONSERVATIVE_EV=0.0
# SNIPER_LONGSHOT_MIN_AMERICAN=200
# SNIPER_MAX_SNAPSHOT_AGE_MINUTES=20
# SNIPER_PAPER_STAKE=1.0
# SNIPER_LINK_STATE=co
# SNIPER_FRESH_MINUTES=10          (the Bet now panel shows flagged prices seen this recently)

# Alerts. With a Discord webhook address here, the scheduled pass posts each new automatic paper bet once while its
# price is fresh. Off when unset. The address is a secret: set it in the environment, never in a committed file.
# SNIPER_ALERT_WEBHOOK_URL=
# SNIPER_ALERT_WEBHOOK_URL_NBA=      (a channel of its own for one sport; also _NFL and _MLB)
# SNIPER_ALERT_MIN_EV=0.04
# SNIPER_ALERT_MAX_PER_PASS=5
# SNIPER_ALERT_MAX_AGE_MINUTES=12

# Models. The model view is recorded beside flagged bets and never changes what is flagged.
# SNIPER_MODEL_VIEW=true
# SNIPER_EVALUATE_EVERY_HOURS=20
